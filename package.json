{
  "name": "antigravity-solid-baseline",
  "version": "1.0.0",
  "description": "2026 Universal Fullstack Foundation & Paved Path Baseline (Solid 2.0, Panda CSS, Ark UI, SpacetimeDB, ConnectRPC, Bun, Oxlint, Biome)",
