{
  "name": "antigravity-solid-baseline",
  "version": "1.0.0",
  "description": "2026 Universal Fullstack Foundation & Paved Path Baseline (Solid 2.0, Panda CSS, Ark UI, SpacetimeDB, ConnectRPC, Bun, Oxlint, Biome)",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun run server/index.ts",
    "dev:client": "vite",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --project-path spacetimedb",
    "spacetime:publish": "spacetime publish --project-path spacetimedb --server http://localhost:3001 system_db",
    "build": "vite build",
    "codegen": "panda codegen --spec",
    "preview": "vite preview",
    "lint": "oxlint src server scripts spacetimedb",
    "format": "biome format --write .",
    "check": "oxlint src server scripts spacetimedb && biome check . && bun run scripts/check-rails.ts && vitest run",
    "check:rails": "bun run scripts/check-rails.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.module.json --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@pandacss/vite": "^2.5.0",
    "@solidjs/diagnostics": "^2.0.0",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "eslint-plugin-solid": "~0.18.1",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.90.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.39.3",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0",
    "spacetimedb": "^2.15.0"
  },
  "patchedDependencies": {
    "solid-js@2.0.0": "patches/solid-js@2.0.0.patch"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
