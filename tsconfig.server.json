{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "server",
    "scripts",
    "panda.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "oxlint.config.ts"
  ]
}
